{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labsafe.local/contracts/DevelopmentDictionary.json",
  "$ref": "#/$defs/DevelopmentDictionary",
  "$defs": {
    "DevelopmentDictionary": {
      "type": "object",
      "properties": {
        "purpose": {
          "type": "string",
          "enum": [
            "development"
          ]
        },
        "dictionary_version_id": {
          "type": "string",
          "format": "uuid"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DevelopmentDictionaryEntry"
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [
        "purpose",
        "dictionary_version_id",
        "entries"
      ],
      "additionalProperties": false
    },
    "DevelopmentDictionaryEntry": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "format": "uuid"
        },
        "canonical_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 0,
          "maxItems": 10
        },
        "cas": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 12
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "entity_id",
        "canonical_name",
        "aliases",
        "cas",
        "source"
      ],
      "additionalProperties": false
    }
  }
}
