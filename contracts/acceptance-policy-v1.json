{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labsafe.local/contracts/AcceptancePolicy.json",
  "$ref": "#/$defs/AcceptancePolicy",
  "$defs": {
    "AcceptancePolicy": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "approved"
          ]
        },
        "profile": {
          "type": "string",
          "enum": [
            "cpu-functional",
            "cuda-single-v1"
          ]
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AcceptanceMetric"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "policy_id",
        "version",
        "status",
        "profile",
        "metrics",
        "description"
      ],
      "additionalProperties": false
    },
    "AcceptanceMetric": {
      "type": "object",
      "properties": {
        "metric_id": {
          "type": "string",
          "enum": [
            "DET-P",
            "DET-R",
            "OCR-NAME",
            "OCR-DATE",
            "ENT-P",
            "ENT-COVER",
            "ENT-OOV",
            "Q-FALSE-REJECT",
            "Q-FALSE-ACCEPT",
            "RISK-P",
            "RISK-R",
            "UNCERTAIN-ROUTING",
            "LATENCY-CUDA"
          ]
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "minItems": 1,
          "maxItems": 10
        },
        "unit": {
          "type": "string",
          "enum": [
            "ratio",
            "seconds"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "ge",
            "le"
          ]
        },
        "target": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "min_denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "min_scene_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "min_positive_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "min_negative_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "metric_id",
        "groups",
        "unit",
        "direction",
        "target",
        "min_denominator",
        "min_scene_count",
        "min_positive_count",
        "min_negative_count"
      ],
      "additionalProperties": false
    }
  }
}
