APP_ENV=dev
API_HOST=127.0.0.1
API_PORT=8000
AI_INFERENCE_HOST=127.0.0.1
AI_INFERENCE_PORT=8001
REDIS_URL=redis://localhost:6379/0
# Identity and foundation APIs are opt-in; use local HTTPS with this exact origin.
API_IDENTITY_ENABLED=0
PUBLIC_ORIGIN=https://labsafe.example.org
CSRF_KEY_FILE=.local-secrets/csrf-key
DATABASE_URL_FILE=.local-secrets/database-url
DATABASE_SCHEMA=labsafe_dev_local

# Dev/test upload grants, validation acceptance and image metadata only. Requires a private,
# versioned bucket, least-privilege API credentials and same-origin HTTPS:443. No consumer yet.
API_UPLOADS_ENABLED=0
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=https://labsafe.example.org
S3_BUCKET=labsafe-private
S3_REGION=us-east-1
S3_ACCESS_KEY_FILE=.local-secrets/s3-api-access-key
S3_SECRET_KEY_FILE=.local-secrets/s3-api-secret-key

AI_MODE=mock
AI_TOKEN_FILE=.local-secrets/ai-token
AI_ALLOWED_TENANTS=11111111-1111-4111-8111-111111111111
AI_MAX_INFLIGHT=1
AI_FIXTURE_SCENARIO=no_targets
AI_FIXTURE_DELAY_MS=0
SERVICE_COMMIT=local-development
VITE_APP_ENV=dev
