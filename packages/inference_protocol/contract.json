  "components": {
    "securitySchemes": {
      "serviceToken": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "UNAUTHENTICATED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "STATE_CONFLICT",
                  "VERSION_CONFLICT",
                  "IDEMPOTENCY_CONFLICT",
                  "REQUEST_IN_PROGRESS",
                  "RATE_LIMITED",
                  "IMAGE_TOO_LARGE",
                  "UNSUPPORTED_MEDIA_TYPE",
                  "IMAGE_INVALID",
                  "UNAUTHORIZED_REF",
                  "OBJECT_NOT_FOUND",
                  "HASH_MISMATCH",
                  "MODEL_NOT_READY",
                  "MODEL_VERSION_UNAVAILABLE",
                  "AI_BUSY",
                  "RUN_IN_PROGRESS",
                  "AI_TIMEOUT",
                  "STAGE_TIMEOUT",
                  "MODEL_OOM",
                  "DEPENDENCY_UNAVAILABLE",
                  "MODEL_ERROR",
                  "INTERNAL_ERROR",
                  "SCHEMA_MISMATCH",
                  "RULESET_INVALID",
                  "LEASE_LOST"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "retryable": {
                "type": "boolean"
              },
              "details": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "minItems": 0,
                "maxItems": 30
              }
            },
            "required": [
              "code",
              "message",
              "retryable",
              "details"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "request_id",
          "error"
        ],
        "additionalProperties": false
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "field",
          "reason"
        ],
        "additionalProperties": false
      },
      "ImageRef": {
        "type": "object",
        "properties": {
          "image_id": {
            "type": "string",
            "format": "uuid"
          },
          "object_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mime_type": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "overview",
              "detail"
            ]
          },
          "location_id": {
            "type": "string",
            "format": "uuid"
          },
          "parent_image_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "image_id",
          "object_key",
          "sha256",
          "mime_type",
          "role",
          "location_id",
          "parent_image_id"
        ],
        "additionalProperties": false
      },
      "InferenceRequest": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "attempt_id": {
            "type": "string",
            "format": "uuid"
          },
          "fencing_token": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "laboratory_id": {
            "type": "string",
            "format": "uuid"
          },
          "item_id": {
            "type": "string",
            "format": "uuid"
          },
          "submission_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "model_bundle_id": {
            "type": "string",
            "format": "uuid"
          },
          "model_checksum": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "dictionary_version_id": {
            "type": "string",
            "format": "uuid"
          },
          "dictionary_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "pipeline_version": {
            "type": "string",
            "enum": [
              "vision-v1"
            ]
          },
          "device_profile": {
            "type": "string",
            "enum": [
              "cpu",
              "cuda"
            ]
          },
          "deadline_at": {
            "type": "string",
            "format": "date-time"
          },
          "request_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "image_refs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImageRef"
            },
            "minItems": 1,
            "maxItems": 3
          }
        },
        "required": [
          "run_id",
          "attempt_id",
          "fencing_token",
          "tenant_id",
          "laboratory_id",
          "item_id",
          "submission_revision",
          "model_bundle_id",
          "model_checksum",
          "dictionary_version_id",
          "dictionary_sha256",
          "pipeline_version",
          "device_profile",
          "deadline_at",
          "request_hash",
          "image_refs"
        ],
        "additionalProperties": false
      },
      "Point": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": false
      },
      "Quality": {
        "type": "object",
        "properties": {
          "image_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "needs_retake"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "blur",
                "dark",
                "glare",
                "occluded",
                "unreadable"
              ]
            },
            "minItems": 0,
            "maxItems": 5
          },
          "blur_score": {
            "type": "number",
            "minimum": 0
          },
          "brightness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "glare_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "image_id",
          "status",
          "reasons",
          "blur_score",
          "brightness",
          "glare_ratio"
        ],
        "additionalProperties": false
      },
      "Detection": {
        "type": "object",
        "properties": {
          "detection_id": {
            "type": "string",
            "format": "uuid"
          },
          "image_id": {
            "type": "string",
            "format": "uuid"
          },
          "parent_detection_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "class_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 79
          },
          "type": {
            "type": "string",
            "enum": [
              "person",
              "bicycle",
              "car",
              "motorbike",
              "aeroplane",
              "bus",
              "train",
              "truck",
              "boat",
              "traffic light",
              "fire hydrant",
              "stop sign",
              "parking meter",
              "bench",
              "bird",
              "cat",
              "dog",
              "horse",
              "sheep",
              "cow",
              "elephant",
              "bear",
              "zebra",
              "giraffe",
              "backpack",
              "umbrella",
              "handbag",
              "tie",
              "suitcase",
              "frisbee",
              "skis",
              "snowboard",
              "sports ball",
              "kite",
              "baseball bat",
